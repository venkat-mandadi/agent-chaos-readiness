{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {"name": "payments-api", "namespace": "payments-prod", "labels": {"app": "payments-api", "team": "payments"}},
      "spec": {"replicas": 4, "template": {"spec": {
        "topologySpreadConstraints": [{"maxSkew": 1, "topologyKey": "topology.kubernetes.io/zone", "whenUnsatisfiable": "DoNotSchedule"}],
        "containers": [{"name": "app", "image": "gcr.io/acme/payments-api:v2.3.1",
          "livenessProbe": {"httpGet": {"path": "/healthz", "port": 8080}},
          "readinessProbe": {"httpGet": {"path": "/ready", "port": 8080}},
          "resources": {"limits": {"cpu": "500m", "memory": "1Gi"}, "requests": {"cpu": "250m", "memory": "512Mi"}}}]
      }}}
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {"name": "catalog-web", "namespace": "catalog-prod", "labels": {"app": "catalog-web"}},
      "spec": {"replicas": 1, "template": {"spec": {
        "containers": [{"name": "web", "image": "nginx:1.25.0",
          "livenessProbe": {"httpGet": {"path": "/", "port": 80}}}]
      }}}
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {"name": "analytics", "namespace": "analytics-prod", "labels": {"app": "analytics"}},
      "spec": {"replicas": 3, "template": {"spec": {
        "containers": [{"name": "analytics", "image": "gcr.io/acme/analytics:v1.0.0",
          "livenessProbe": {"httpGet": {"path": "/healthz", "port": 8000}},
          "readinessProbe": {"httpGet": {"path": "/ready", "port": 8000}},
          "resources": {"limits": {"cpu": "1", "memory": "2Gi"}, "requests": {"cpu": "500m", "memory": "1Gi"}}}]
      }}}
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {"name": "orders-db", "namespace": "payments-prod", "labels": {"app": "orders-db"}},
      "spec": {"replicas": 3, "template": {"spec": {
        "topologySpreadConstraints": [{"maxSkew": 1, "topologyKey": "topology.kubernetes.io/zone", "whenUnsatisfiable": "DoNotSchedule"}],
        "containers": [{"name": "db", "image": "gcr.io/acme/orders-db:v5.2.0",
          "livenessProbe": {"tcpSocket": {"port": 5432}},
          "readinessProbe": {"tcpSocket": {"port": 5432}},
          "resources": {"limits": {"cpu": "2", "memory": "4Gi"}, "requests": {"cpu": "1", "memory": "2Gi"}}}]
      }}}
    },
    {
      "apiVersion": "policy/v1",
      "kind": "PodDisruptionBudget",
      "metadata": {"name": "payments-api-pdb", "namespace": "payments-prod"},
      "spec": {"minAvailable": 3, "selector": {"matchLabels": {"app": "payments-api"}}}
    },
    {
      "apiVersion": "policy/v1",
      "kind": "PodDisruptionBudget",
      "metadata": {"name": "orders-db-pdb", "namespace": "payments-prod"},
      "spec": {"maxUnavailable": 1, "selector": {"matchLabels": {"app": "orders-db"}}}
    }
  ]
}
